---
// Root-relative, not bare fragments: `#about` would resolve against
// /all-reading/ and go nowhere. On the homepage these are still
// same-document jumps, so smooth scrolling is unaffected.
const links = [
	{ label: "About", href: "/#about" },
	{ label: "Experience", href: "/#experience" },
	// Reading is parked for now; /all-reading/ stays live at its own URL.
	// { label: "Reading", href: "/#reading" },
	{ label: "Contact", href: "/#contact" },
];
---

<header
	class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-4 px-6 py-8"
>
	<a href="/" class="text-lg font-semibold tracking-tight">anikeshk</a>

	<nav class="label-eyebrow flex flex-wrap items-center gap-x-4 gap-y-2 sm:gap-x-6">
		{
			links.map((link) => (
				<a href={link.href} class="link-underline">
					{link.label}
				</a>
			))
		}

		<button
			id="theme-toggle"
			type="button"
			class="-my-1 rounded-full p-1 text-muted-foreground transition-colors hover:text-brand"
			aria-label="Toggle colour theme"
		>
			<svg
				class="icon-moon h-4 w-4"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
			</svg>
			<svg
				class="icon-sun h-4 w-4"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<circle cx="12" cy="12" r="4"></circle>
				<path
					d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
				></path>
			</svg>
		</button>
	</nav>
</header>

<script>
	const toggle = document.getElementById("theme-toggle");

	toggle?.addEventListener("click", () => {
		const root = document.documentElement;
		// Reading the computed colour-scheme resolves the OS preference too,
		// so the first click always flips away from what is actually on screen.
		const isDark = getComputedStyle(root).colorScheme.includes("dark");
		const next = isDark ? "light" : "dark";

		root.dataset.theme = next;
		localStorage.setItem("theme", next);
	});
</script>
