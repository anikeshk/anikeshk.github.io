---
// About is a section on the single page now. This keeps the old /about URL alive.
const target = "/#about";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0; url=${target}`} />
		<link rel="canonical" href={new URL(target, Astro.site)} />
		<meta name="robots" content="noindex" />
		<title>Redirecting to About — Anikesh G Kamath</title>
		<script is:inline define:vars={{ target }}>
			window.location.replace(target);
		</script>
	</head>
	<body>
		<p>This page has moved. <a href={target}>Continue to About</a>.</p>
	</body>
</html>
