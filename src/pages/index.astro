---
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";
// import ReadingItem from "../components/reading-item.astro";
import Main from "../layouts/main.astro";
import experienceData from "../data/experience.yaml";
import focusData from "../data/focus.yaml";
// import readingData from "../data/reading.yaml";

// YAML imports arrive untyped; these shapes mirror the files in src/data/.
interface Focus {
	title: string;
	note: string;
}

interface Experience {
	period: string;
	role: string;
	org: string;
	place: string;
	note: string;
	tags: string[];
	current?: boolean;
}

// interface Reading {
// 	title: string;
// 	source: string;
// 	url: string;
// 	tags?: string[];
// 	note?: string;
// 	highlighted?: boolean;
// }

const focus = focusData as Focus[];
const experience = experienceData as Experience[];
// const reading = readingData as Reading[];

const title = "Anikesh G Kamath — Security Automation & Backend Engineer";
const description =
	"Software engineer in Santa Clara building security automation — vulnerability detection and remediation, software supply chain security, and agentic AI pipelines on AWS. Currently Senior Software Engineer at Lineaje.";

// The homepage shows the picks; /all-reading/ lists everything, filterable.
// const readingHighlights = reading.filter((item) => item.highlighted);
---

<Main title={title} description={description}>
	<Header />

	<main class="mx-auto max-w-3xl px-6">
		<section class="rise py-16 sm:py-24">
			<p class="label-eyebrow">Santa Clara, California</p>
			<h1
				class="mt-5 text-balance font-display text-5xl font-semibold leading-[1.05] tracking-tight sm:text-6xl"
			>
				Anikesh G Kamath
			</h1>

			<p class="mt-6 max-w-2xl text-pretty text-lg leading-relaxed">
				Software engineer building security automation — the APIs, pipelines, and agentic
				workflows that turn security findings into fixes.
			</p>
			<p class="mt-3 text-[0.9375rem] text-muted-foreground">
				<span class="font-semibold text-foreground">Senior Software Engineer at Lineaje</span
				> · MSCS from Northeastern
			</p>

			<div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm font-medium">
				<a href="mailto:anikesh.kamath@gmail.com" class="link-underline">Email</a>
				<a
					href="https://www.linkedin.com/in/anikeshk/"
					target="_blank"
					rel="noreferrer"
					class="link-underline text-muted-foreground"
				>
					LinkedIn
				</a>
				<a
					href="https://github.com/anikeshk"
					target="_blank"
					rel="noreferrer"
					class="link-underline text-muted-foreground"
				>
					GitHub
				</a>
			</div>
		</section>

		<section id="about" class="rule-top py-16">
			<p class="label-eyebrow">About</p>
			<div class="mt-6 space-y-5 text-base leading-relaxed text-muted-foreground">
				<p>
					I&apos;ve spent most of my career building software for security teams. At
					McAfee that meant putting machine learning models behind production APIs for
					malware detection, and learning what it takes to run them reliably at scale. At
					Lineaje it meant software supply chain security — SBOMs, vulnerability
					aggregation, and secret scanning — before I went back for a Master&apos;s in
					Computer Science at Northeastern, finished in May 2025, focused on distributed
					systems and cloud-native architecture.
				</p>
				<p>
					Today I build security automation end to end: detection-to-remediation workflows
					across source code and OSS dependencies, event-driven pipelines and
					OpenSearch-backed datasets in the hundreds of millions of documents, and agentic
					systems that pair LLM reasoning with deterministic, auditable engineering. Most
					of it ships alongside the security engineers who use it, which is the part I
					like: tooling only counts if people adopt it.
				</p>
				<p>
					Alongside the technical work I&apos;ve spent a lot of time on leadership,
					mentorship, and teaching at Northeastern, and was honored with the <a
						href="https://www.khoury.northeastern.edu/banner-year-for-khoury-students-at-2025-university-convocation-awards/#:~:text=Anikesh%20Ganesh%20Kamath%2C%20Laurel%20and%20Scroll%20100"
						target="_blank"
						rel="noreferrer"
						class="link-prose"
					>Laurel and Scroll 100</a> award under the Society of Distinctions, and the <a
						href="https://www.linkedin.com/posts/anikeshk_lead360-share-7279927264383799296-ll_S/"
						target="_blank"
						rel="noreferrer"
						class="link-prose"
					>Emerging Graduate Student Leader Award</a>. I&apos;m drawn to product security
					and platform teams building the automation that protects everything else —
					systems that are robust, explainable, and genuinely production-ready.
				</p>
			</div>
		</section>

		<section class="rule-top py-16">
			<p class="label-eyebrow">What I work on</p>
			<dl class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2">
				{
					focus.map((item) => (
						<div class="border-l-2 border-foreground pl-4">
							<dt class="font-display text-xl font-semibold tracking-tight">
								{item.title}
							</dt>
							<dd class="mt-2 text-[0.9375rem] leading-relaxed text-muted-foreground">
								{item.note}
							</dd>
						</div>
					))
				}
			</dl>
		</section>

		<section id="experience" class="rule-top py-16">
			<p class="label-eyebrow">Experience</p>
			<ol class="mt-8 space-y-9">
				{
					experience.map((item) => (
						<li class:list={["step-item", item.current && "step-item-current"]}>
							<p class="label-meta">{item.period}</p>
							<h3 class="mt-1.5 font-display text-xl font-semibold leading-tight tracking-tight">
								{item.role}
							</h3>
							<p class="mt-1 text-sm font-semibold">
								{item.org} <span class="text-muted-foreground">· {item.place}</span>
							</p>
							<p class="mt-2 max-w-xl text-[0.9375rem] leading-relaxed text-muted-foreground">
								{item.note}
							</p>
							<p class="mt-2 text-sm text-muted-foreground">{item.tags.join(" · ")}</p>
						</li>
					))
				}
			</ol>
		</section>

		{/* Reading section parked for now — /all-reading/ is still live.
		<section id="reading" class="rule-top py-16">
			<p class="label-eyebrow">Reading</p>
			<p class="mt-4 max-w-xl text-[0.9375rem] leading-relaxed text-muted-foreground">
				Engineering writing worth passing on — blogs and articles I keep coming back to.
			</p>

			`note` is rendered on /all-reading/ only — here the list stays a scan-list.
			<ul class="mt-6">
				{readingHighlights.map((item) => <ReadingItem {...item} />)}
			</ul>

			<a href="/all-reading/" class="label-meta link-underline mt-8 inline-block">
				All reading →
			</a>
		</section>
		*/}

		<section id="contact" class="rule-top py-16">
			<p class="label-eyebrow">Let&apos;s connect</p>
			<p
				class="mt-6 max-w-2xl text-balance font-display text-2xl font-semibold leading-snug tracking-tight sm:text-3xl"
			>
				Building security or developer infrastructure at scale? I&apos;d love to compare
				notes.
			</p>

			<div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm font-medium">
				<a href="mailto:anikesh.kamath@gmail.com" class="link-underline">Email</a>
				<a
					href="https://www.linkedin.com/in/anikeshk/"
					target="_blank"
					rel="noreferrer"
					class="link-underline text-muted-foreground"
				>
					LinkedIn
				</a>
				<a
					href="https://github.com/anikeshk"
					target="_blank"
					rel="noreferrer"
					class="link-underline text-muted-foreground"
				>
					GitHub
				</a>
			</div>
		</section>
	</main>

	<Footer />
</Main>
